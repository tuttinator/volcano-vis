{
  "name": "volcano-vis",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "test": "node --import tsx --test tests/*.test.ts",
    "preview": "vite preview --host 127.0.0.1",
    "data:build": "python3 pipelines/build_data.py && node --import tsx --test tests/contracts.test.ts",
    "site:export": "python3 pipelines/export_site.py",
    "build:embed": "tsc --noEmit && vite build --base=/experiments/volcanoes/ --outDir=dist-blog",
    "test:embed": "playwright test --config=playwright.embed.config.ts"
  },
  "dependencies": {
    "maplibre-gl": "^6.9.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0"
  }
}
