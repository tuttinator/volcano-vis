{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "volcanoId",
    "title",
    "timeZone",
    "start",
    "end",
    "preferredStart",
    "bounds",
    "assets",
    "presentation"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "volcanoId": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "timeZone": {
      "type": "string",
      "minLength": 1
    },
    "start": {
      "type": "string",
      "format": "date-time"
    },
    "end": {
      "type": "string",
      "format": "date-time"
    },
    "preferredStart": {
      "type": "string",
      "format": "date-time"
    },
    "bounds": {
      "type": "array",
      "items": {
        "type": "number"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "assets": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infrared",
        "ashRgb",
        "timeline",
        "chronology",
        "airports",
        "advisories",
        "airportStatus",
        "observations"
      ],
      "properties": {
        "infrared": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.json$"
        },
        "ashRgb": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.json$"
        },
        "timeline": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.json$"
        },
        "chronology": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.json$"
        },
        "airports": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.json$"
        },
        "advisories": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.geojson$"
        },
        "airportStatus": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.json$"
        },
        "observations": {
          "type": "string",
          "pattern": "^/data/[^?#]+\\.geojson$"
        }
      }
    },
    "presentation": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "heading",
        "description",
        "place",
        "timeZoneLabel",
        "advisoryCoverageNote",
        "airportSummary"
      ],
      "properties": {
        "heading": {
          "type": "string",
          "minLength": 1
        },
        "description": {
          "type": "string",
          "minLength": 1
        },
        "place": {
          "type": "string",
          "minLength": 1
        },
        "timeZoneLabel": {
          "type": "string",
          "minLength": 1
        },
        "advisoryCoverageNote": {
          "type": "string",
          "minLength": 1
        },
        "airportSummary": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
