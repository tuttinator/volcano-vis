{
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "eventId",
    "airports",
    "closureReport",
    "sources",
    "limitations"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "eventId": {
      "type": "string",
      "minLength": 1
    },
    "airports": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "closureListed",
          "reopenedAt",
          "reopeningSourceId",
          "notes"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "closureListed": {
            "type": "boolean"
          },
          "reopenedAt": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ]
          },
          "reopeningSourceId": {
            "anyOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "null"
              }
            ]
          },
          "notes": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "closureReport": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "sourceId",
            "closedBy",
            "actualStart",
            "plannedUntil",
            "notes"
          ],
          "properties": {
            "sourceId": {
              "type": "string",
              "minLength": 1
            },
            "closedBy": {
              "type": "string",
              "format": "date-time"
            },
            "actualStart": {
              "type": "null"
            },
            "plannedUntil": {
              "type": "string",
              "format": "date-time"
            },
            "notes": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        {
          "type": "null"
        }
      ]
    },
    "sources": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "publishedDate",
          "url",
          "localPath",
          "sha256"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "provider": {
            "type": "string",
            "minLength": 1
          },
          "publishedDate": {
            "type": "string",
            "format": "date"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "localPath": {
            "type": "string",
            "minLength": 1
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        }
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}
